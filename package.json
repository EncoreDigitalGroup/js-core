{
    "name": "tsfmt",
    "author": "Encore Digital Group",
    "version": "0.0.0",
    "description": "An opinionated TypeScript code formatter",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "glob": "^13.0.0",
        "json-sort-cli": "^4.0.9",
        "reflect-metadata": "^0.2.2",
        "sort-package-json": "^3.0.0",
        "ts-morph": "^28.0.0",
        "typescript": "^6.0.2",
        "vite": "^8.0.2"
    },
    "scripts": {
        "build": "bun scripts/build.ts",
        "build:release": "bun scripts/build.ts --all",
        "dev": "bun src/cli.ts",
        "format": "bun src/cli.ts",
        "prepack": "bun scripts/build.ts --types-only",
        "test": "bun test",
        "upload:binaries": "bun scripts/build.ts --upload"
    },
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "scripts/tsfmt-bin.js",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "https://gitlab.encoredigitalgroup.com/oss/tsfmt.git"
    },
    "license": "BSD-3-Clause",
    "bin": {
        "tsfmt": "./scripts/tsfmt-bin.js"
    }
}
